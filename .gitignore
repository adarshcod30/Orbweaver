# data — never committed
data/raw/
data/processed/
*.parquet
# The demo bundle is the one exception: it is small, it is generated by
# `make demo-bundle`, and it is meant to be cloned - the console serves it
# when there is no processed data. The blanket rule above swallowed it and
# the first push shipped a bundle with its account table missing.
!demo/*.parquet
*.npy
*.npz
*.pth
*.pt
*.ckpt
*.pkl
*.joblib

# secrets
.env
.env.*
*.pem
*.key

# python
__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# notebooks
.ipynb_checkpoints/

# os / editors
.DS_Store
.idea/
.vscode/
*.swp

# scratch figures; the final ones under docs/figures are kept
docs/figures/_scratch/
